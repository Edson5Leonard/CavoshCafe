<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".ui.Inicio">

    <!-- Header Contenedor -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sh_header_police_blue"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo de fondo de café -->
        <ImageView
            android:id="@+id/ivFondoCafe"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:contentDescription="@string/content_description"
            android:alpha="0.15"
            android:src="@drawable/logo_cafes"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Título Superior -->
        <TextView
            android:id="@+id/tvTituloApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cavosh"
            android:textColor="@color/carmine_pink"
            android:textStyle="bold"
            android:textSize="18sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Saludo Usuario -->
        <TextView
            android:id="@+id/tvUsuario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Good morning, user"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvTituloApp"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Notificación icono + indicador -->
        <ImageView
            android:id="@+id/ivNotificacion"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/content_description"
            android:src="@drawable/ic_notificacion"
            app:layout_constraintTop_toTopOf="@id/tvUsuario"
            app:layout_constraintBottom_toBottomOf="@id/tvUsuario"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/viNotificacion"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/se_notificacion"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="@id/ivNotificacion"
            app:layout_constraintEnd_toEndOf="@id/ivNotificacion" />

        <!-- Detalle del café -->
        <TextView
            android:id="@+id/tvEtiquetaCafe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your cafe: "
            android:textColor="#D0D7DE"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tvUsuario"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvCafe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Cavosh Cafe\nLegnicka 20, Wrocław"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/tvEtiquetaCafe"
            app:layout_constraintStart_toEndOf="@id/tvEtiquetaCafe"
            app:layout_constraintEnd_toStartOf="@id/tvCafeCambiar" />

        <TextView
            android:id="@+id/tvCafeCambiar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            app:layout_constraintTop_toTopOf="@id/tvEtiquetaCafe"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Barra de Búsqueda Flotante -->
    <androidx.appcompat.widget.SearchView
        android:id="@+id/svBuscar"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:background="@drawable/sh_btn_light_silver"
        android:elevation="6dp"
        app:iconifiedByDefault="false"
        app:queryHint="Search"
        app:queryBackground="@null"
        app:layout_constraintTop_toBottomOf="@id/clHeader"
        app:layout_constraintBottom_toBottomOf="@id/clHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sección: New in -->
    <TextView
        android:id="@+id/tvTextoNuevo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:text="New in"
        android:textColor="#1A1A1A"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/svBuscar"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNuevos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTextoNuevo"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Sección: Frequently ordered -->


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFrecuentes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        app:layout_constraintTop_toBottomOf="texto ordenardos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>