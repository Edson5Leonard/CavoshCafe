<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.Registrar">

    <TextView
        android:id="@+id/tvHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/sh_header_police_blue"
        android:paddingVertical="32dp"
        android:paddingHorizontal="16dp"
        android:text="Vamos a iniciar sessión"
        android:textColor="@color/flesh"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvIniciarSesion"
        android:layout_width="172dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="-16dp"
        android:background="@drawable/sh_btn_carmine_pink"
        android:elevation="5dp"
        android:paddingVertical="12dp"
        android:text="Iniciar sesión"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintStart_toStartOf="parent"/>

    <TextView
        android:id="@+id/tvRegistrar"
        android:layout_width="172dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="-16dp"
        android:background="@drawable/sh_btn_light_silver"
        android:elevation="4dp"
        android:paddingVertical="12dp"
        android:text="Registrar"
        android:textAlignment="center"
        android:textColor="@color/gunmetal"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvHeader"
        app:layout_constraintStart_toEndOf="@id/tvIniciarSesion"/>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCorreo"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:layout_constraintTop_toBottomOf="@+id/tvIniciarSesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/tv_bright_gray"
            android:paddingHorizontal="16dp"
            android:inputType="textEmailAddress"
            android:maxLength="50"
            android:hint="Email"/>
    </com.google.android.material.textfield.TextInputLayout>



    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPassword"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:hintEnabled="false"
        app:endIconMode="password_toggle"
        app:layout_constraintTop_toBottomOf="@+id/tilCorreo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/tv_bright_gray"
            android:paddingHorizontal="16dp"
            android:inputType="textEmailAddress"
            android:maxLength="50"
            android:hint="Password"/>
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="32dp"
        android:clickable="true"
        android:focusable="true"
        android:text="recupar password"
        android:textColor="@color/carmine_pink"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/tilPassword"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <Button
        android:id="@+id/btnIniciarSesion"
        android:layout_width="360dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/sh_btn_gunmetal"
        android:text="Login"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tilPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <View
        android:layout_width="96dp"
        android:layout_height="2dp"
        android:layout_marginTop="48dp"
        android:layout_marginStart="32dp"
        android:background="@color/carmine_pink"
        app:layout_constraintTop_toBottomOf="@id/btnIniciarSesion"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="96dp"
        android:layout_height="2dp"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="32dp"
        android:background="@color/carmine_pink"
        app:layout_constraintTop_toBottomOf="@id/btnIniciarSesion"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Login with"
        android:textColor="@color/gunmetal"
        app:layout_constraintTop_toBottomOf="@id/btnIniciarSesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/ivFacebook"
        android:layout_width="96dp"
        android:layout_height="84dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/sh_btn_flesh"
        android:contentDescription="texto_facebook"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp"
        android:src="@drawable/ic_facebook"

        app:layout_constraintTop_toBottomOf="@id/btnIniciarSesion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/ivGoogle"
        android:layout_width="108dp"
        android:layout_height="84dp"
        android:layout_marginTop="96dp"
        android:background="@drawable/sh_btn_flesh"
        android:clickable="true"
        android:contentDescription="texto_google"
        android:focusable="true"
        android:padding="20dp"
        android:src="@drawable/ic_google_plus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.894"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnIniciarSesion" />

    <ImageView
        android:id="@+id/ivApple"
        android:layout_width="108dp"
        android:layout_height="84dp"
        android:layout_marginTop="96dp"
        android:layout_marginStart="32dp"
        android:background="@drawable/sh_btn_flesh"
        android:contentDescription="@string/texto_apple"
        android:clickable="true"
        android:focusable="true"
        android:padding="20dp"
        android:src="@drawable/ic_apple"

        app:layout_constraintTop_toBottomOf="@id/btnIniciarSesion"
        app:layout_constraintStart_toStartOf="parent"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="15dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No tienes cuenta"
            android:textColor="@color/gunmetal" />

        <TextView
            android:id="@+id/tvRegistrarAhora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registrase"
            android:textColor="@color/carmine_pink" />

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>