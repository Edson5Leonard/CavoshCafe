<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Contenedor del Icono -->
    <FrameLayout
        android:id="@+id/flIconContainer"
        android:layout_width="64dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_customization_pill"
        android:padding="8dp">

        <LinearLayout
            android:id="@+id/llContentPill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                app:tint="#E85D42"
                tools:src="@drawable/ic_leche" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#F3A395"
                android:textSize="11sp"
                tools:text="Milk" />

            <TextView
                android:id="@+id/tvValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E85D42"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Oat" />
        </LinearLayout>
    </FrameLayout>

    <!-- Texto inferior para el botón de acción Change -->
    <TextView
        android:id="@+id/tvActionLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Change"
        android:textColor="#8A94A6"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>